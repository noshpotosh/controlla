+// WASM paired FP eligibility attribution: opt-in helper calls, no arithmetic changes.
+extern "C" int DolphinWeb_CachedInterpreterFpEligibilityOp(int state_ptr, u32 inst_hex,
+                                                          u32 current_pc, u32 downcount, u32 unused)
+{
+  if (s_ppc_block_profile_enabled)
+  {
+    const UGeckoInstruction inst{inst_hex};
+    if (inst.OPCD == 4 && (inst.SUBOP5 == 20 || inst.SUBOP5 == 21))
+    {
+      const auto& state = *reinterpret_cast<PowerPC::PowerPCState*>(
+          static_cast<std::uintptr_t>(state_ptr));
+      constexpr u64 magnitude = 0x7fffffffffffffffULL;
+      const bool zero_lane1 = (state.ps[inst.FA].PS1AsU64() & magnitude) == 0 &&
+                              (state.ps[inst.FB].PS1AsU64() & magnitude) == 0;
+      const u32 bucket = (state.fpscr.Hex & 7) | (inst.Rc ? 8 : 0) | (zero_lane1 ? 16 : 0);
+      s_paired_fp_eligibility[bucket].fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  return DolphinWeb_CachedInterpreterFpOp(state_ptr, inst_hex, current_pc, downcount, unused);
+}
