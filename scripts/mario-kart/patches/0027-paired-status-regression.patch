+              if (halt != expected_halt) return 503;
+              if (state.ps[destination].PS0AsU64() != expected0 ||
+                  state.ps[destination].PS1AsU64() != expected1) return 504;
+              if (state.fpscr.Hex != expected_fpscr) return 505;
+              if (state.Exceptions != expected_exceptions || state.npc != expected_npc) return 506;
+              for (u32 field = 0; field < 8; ++field)
+                if (state.cr.GetField(field) != expected_cr[field]) return 507;
+            }
+  return 1;
