+// WASM scale-zero quantized store candidate: preserve float conversion and NaN fallback.
+void EmitStorePsqScaleZero(std::vector<u8>& body, const WasmStateLayout& layout,
+                           UGeckoInstruction inst, bool signed_halfword)
+{
+  for (u32 lane = 0; lane < (inst.W ? 1u : 2u); ++lane)
+  {
+    EmitStateLoadF64(body, PsOffset(layout, inst.RS, lane));
+    body.push_back(0xb6);  // f32.demote_f64: quantization first rounds to float.
+    body.push_back(0xbb);  // f64.promote_f32
+    EmitF64ConstBits(body, std::bit_cast<u64>(signed_halfword ? -32768.0 : 0.0));
+    body.push_back(0xa5);  // f64.max
+    EmitF64ConstBits(body, std::bit_cast<u64>(signed_halfword ? 32767.0 : 255.0));
+    body.push_back(0xa4);  // f64.min
+    body.push_back(0xfc);
+    EmitU32Leb(body, 2);  // i32.trunc_sat_f64_s
+    EmitLocalSet(body, 2);
+    if (signed_halfword)
+    {
+      EmitBswap16FromLocal(body, 2);
+      EmitLocalSet(body, 3);
+    }
+    EmitRamAddress(body, layout);
+    EmitLocalGet(body, signed_halfword ? 3 : 2);
+    body.push_back(signed_halfword ? 0x3b : 0x3a);
+    body.push_back(0x00);
+    EmitU32Leb(body, lane * (signed_halfword ? 2 : 1));
+  }
+}
