+// WASM sampled FP helper timing: opt-in wall time, no arithmetic changes.
+std::atomic<u64> s_fp_timing_samples{0};
+std::atomic<u64> s_fp_timing_total_ns{0};
+std::atomic<u64> s_fp_timing_max_ns{0};
+struct SampledFpHelperTiming
+{
+  bool sampled;
+  std::chrono::steady_clock::time_point start{};
+  SampledFpHelperTiming() : sampled(s_ppc_block_profile_enabled &&
+                                    (s_wasm_fp_call_count & 1023u) == 0)
+  {
+    if (sampled) start = std::chrono::steady_clock::now();
+  }
+  ~SampledFpHelperTiming()
+  {
+    if (!sampled) return;
+    const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - start).count();
+    const u64 ns = elapsed > 0 ? static_cast<u64>(elapsed) : 0;
+    s_fp_timing_samples.fetch_add(1, std::memory_order_relaxed);
+    s_fp_timing_total_ns.fetch_add(ns, std::memory_order_relaxed);
+    u64 max = s_fp_timing_max_ns.load(std::memory_order_relaxed);
+    while (max < ns && !s_fp_timing_max_ns.compare_exchange_weak(
+        max, ns, std::memory_order_relaxed)) {}
+  }
+};
+
