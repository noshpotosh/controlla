+// WASM finite paired add/sub candidate: retain reference conversion and status.
+bool TryFinitePairedAddSub(PowerPC::PowerPCState& state, UGeckoInstruction inst)
+{
+  const auto& a = state.ps[inst.FA];
+  const auto& b = state.ps[inst.FB];
+  constexpr u64 exponent = 0x7ff0000000000000ULL;
+  if ((a.PS0AsU64() & exponent) == exponent || (a.PS1AsU64() & exponent) == exponent ||
+      (b.PS0AsU64() & exponent) == exponent || (b.PS1AsU64() & exponent) == exponent)
+    return false;
+  const bool subtract = inst.SUBOP5 == 20;
+  const double result0 = subtract ? a.PS0AsDouble() - b.PS0AsDouble() :
+                                    a.PS0AsDouble() + b.PS0AsDouble();
+  const double result1 = subtract ? a.PS1AsDouble() - b.PS1AsDouble() :
+                                    a.PS1AsDouble() + b.PS1AsDouble();
+  const float ps0 = ForceSingle(state.fpscr, result0);
+  const float ps1 = ForceSingle(state.fpscr, result1);
+  state.ps[inst.FD].SetBoth(ps0, ps1);
+  state.UpdateFPRFSingle(ps0);
+  if (inst.Rc)
+    state.UpdateCR1();
+  return true;
+}
